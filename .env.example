# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google (Gmail)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:4567/oauth/callback
GMAIL_USER=...@gmail.com

# Telegram
TELEGRAM_BOT_TOKEN=...
TELEGRAM_FOUNDER_CHAT_ID=...

# Paths
# Default: ./data/wiki (project-local, safe for dev/seed). Point at the real
# neuromcp wiki (e.g. /Users/a/.neuromcp/wiki) only when going live.
NEUROMCP_WIKI_PATH=./data/wiki
DATA_DIR=./data
METRICS_DIR=./metrics
